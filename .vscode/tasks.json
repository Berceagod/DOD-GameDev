{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C++: build raylib + imgui",
            "command": "g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "main.cpp",
                "rlImGui/rlImGui.cpp",
                "imgui/imgui.cpp",
                "imgui/imgui_draw.cpp",
                "imgui/imgui_tables.cpp",
                "imgui/imgui_widgets.cpp",
                "imgui/imgui_demo.cpp",
                "-o", "main.exe",
                "-O1",
                "-Wall",
                "-std=c++17",
                "-Wno-missing-braces",
                "-I", "imgui",
                "-I", "rlImGui",
                "-I", "C:/raylib/raylib/src",
                "-L", "C:/raylib/raylib/src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles main.cpp + ImGui + rlImGui and links raylib"
        }
    ]
}