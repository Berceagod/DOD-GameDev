{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C++: build raylib + imgui",
            "command": "g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                //"-g",
                "main.cpp",
				"benchmark.cpp",
                "-o", "main.exe",
                //"-O1",
                "-O3",
                "-Wall",
                "-std=c++17",
                "-Wno-missing-braces",
                "-I", "imgui",
                "-I", "rlImGui",
                "-I", "C:/raylib/raylib/src",
                "-L", "build",
                "-L", "C:/raylib/raylib/src",
                "-limgui_all",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles main.cpp and links the prebuilt ImGui library"
        }
    ]
}